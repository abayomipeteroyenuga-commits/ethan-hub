{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/"
    },
    {
      "source": "/auth/callback/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}